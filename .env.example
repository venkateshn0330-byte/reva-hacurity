# ==============================================================================
# AgentShield Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env and populate with high-entropy production secrets.
# NEVER commit the active .env file or production keys to version control.

# Deployment Environment ('production' enforces strict origins, host verification,
# disables dev-mode fallbacks, and requires secure HttpOnly cookie transport).
AGENTSHIELD_ENV=production

# Master Admin Key for administrative automation and project provisioning.
# Generate a fresh 256-bit cryptographic key using:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENTSHIELD_ADMIN_KEY=CHANGE_ME_GENERATE_SECURE_RANDOM_SECRET_KEY

# Persistent Database Filepath.
# In containerized/VM deployments, point this to a persistent mounted volume.
# Default fallback: agentshield/data/events.db
AGENTSHIELD_DB_PATH=/var/lib/agentshield/data/events.db

# Explicit CORS Allowed Origins (Comma-separated list).
# Wildcard credentials are strictly rejected. Only allow your trusted frontend domains.
# Example: https://dashboard.yourdomain.com,https://agentshield.internal
AGENTSHIELD_ALLOWED_ORIGINS=https://agentshield.example.com

# DNS Rebinding Firewall: Explicit Allowed Host Headers (Comma-separated list).
# Prevents hostile web pages from executing DNS rebinding attacks against loopback/internal gateways.
AGENTSHIELD_ALLOWED_HOSTS=agentshield.example.com,api.agentshield.example.com

# Force Secure Cookie Flag (0 = auto-detect via HTTPS/X-Forwarded-Proto, 1 = force Secure).
# Must be enabled when serving behind an HTTPS-terminating reverse proxy.
AGENTSHIELD_SECURE_COOKIES=1

# Development Fallback Mode (MUST BE 0 in production).
# Setting this to 1 permits 'agentshield-dev-key' bypass on loopback only.
AGENTSHIELD_DEV_MODE=0

# Server Listening Bind Address and Port
HOST=0.0.0.0
PORT=8000
